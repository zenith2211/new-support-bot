####################################################################
#  Copy to .env (local) or paste these into your host's dashboard.
#  Nothing here has a real value — fill in your own.
####################################################################

# ─── REQUIRED ─────────────────────────────────────────────────
# From @BotFather
BOT_TOKEN=

# Your Telegram numeric id. Comma-separate for several admins.
# Send /id to the bot to find yours.
ADMIN_IDS=

# ─── BRANDING ─────────────────────────────────────────────────
STORE_NAME=Your Store Bot
BOT_LINK=https://t.me/yourbot
SUPPORT_USERNAME=your_support_username
CHANNEL_LINK=https://t.me/yourchannel
CURRENCY=USD

# ─── CHANNEL POSTS ────────────────────────────────────────────
# Channel that receives NEW ORDER / WALLET FUNDED / ALMOST GONE posts.
# Add the bot as an admin there. Ids look like -1001234567890.
LOG_CHANNEL_ID=

# ─── FORCE JOIN (optional) ────────────────────────────────────
FORCE_JOIN=0
FORCE_JOIN_CHANNEL_ID=
FORCE_JOIN_LINK=https://t.me/yourchannel
FORCE_JOIN_NAME=your channel

# ─── POSTERS ──────────────────────────────────────────────────
# Each can be an https:// url, a Telegram file_id, or a path to a file in
# the repo. Leave blank to send that screen as plain text.
# Tip: send the image to your bot, then read the file_id from the API.
BANNER_START=
BANNER_PRODUCTS=
BANNER_WALLET=
BANNER_ORDERS=
BANNER_GIFT=
BANNER_SUPPORT=
BANNER_PROFILE=
POSTER_NEW_ORDER=
POSTER_WALLET_FUNDED=
POSTER_ALMOST_GONE=
POSTER_DELIVERED=

# ─── STORE RULES ──────────────────────────────────────────────
MIN_TOPUP=0.100
MAX_TOPUP=5000
PRICE_DECIMALS=3
ORDER_EXPIRY_MINUTES=30
LOW_STOCK_THRESHOLD=3
DEFAULT_LANG=en
REFERRAL_BONUS=0

# ─── BINANCE PAY ──────────────────────────────────────────────
# merchant.binance.com -> Developers. The Binance Pay button only appears
# once both of these are set.
BINANCE_PAY_KEY=
BINANCE_PAY_SECRET=
BINANCE_PAY_CURRENCY=USDT
BINANCE_PAY_BASE=https://bpay.binanceapi.com
# Optional: shown to customers who prefer paying your Pay ID by hand.
BINANCE_PAY_ID=

# ─── MANUAL PAYMENTS (optional) ───────────────────────────────
# Adds a "pay by hand" method: the customer presses "I have paid" and an
# admin approves it in the bot.
MANUAL_PAY=0
MANUAL_PAY_LABEL=Pay manually

# ─── CATALOG API (optional) ───────────────────────────────────
# Set a key to expose GET /api/catalog (read-only prices and stock).
STORE_API_KEY=

# ─── BUTTON EXTRAS ────────────────────────────────────────────
# Coloured buttons (green confirm / red cancel / teal primary). Verified
# working on Telegram Desktop 7.1.4; older clients ignore the field and show
# the default colour. Set to 0 only if you want everything plain.
BUTTON_STYLES=1
# Premium emoji *inside* the button chrome. Unverified — off by default; the
# button's emoji comes from its label text instead, which works everywhere.
BUTTON_ICONS=0

# ─── RUNTIME ──────────────────────────────────────────────────
PORT=10000
POLL_TIMEOUT=30
LOG_LEVEL=INFO
# Where the JSON data files live. Point this at a mounted disk in production.
DATA_DIR=
