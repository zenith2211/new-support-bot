####################################################################
#  Copy to .env (local) or paste these into your host's dashboard.
#  Nothing here has a real value — fill in your own.
####################################################################

# ─── REQUIRED ─────────────────────────────────────────────────
# From @BotFather
BOT_TOKEN=

# Your Telegram numeric id. Comma-separate for several admins.
# Send /id to the bot to find yours.
ADMIN_IDS=

# ─── BRANDING ─────────────────────────────────────────────────
STORE_NAME=Your Store Bot
BOT_LINK=https://t.me/yourbot
SUPPORT_USERNAME=your_support_username
CHANNEL_LINK=https://t.me/yourchannel
CURRENCY=USD

# ─── CHANNEL POSTS ────────────────────────────────────────────
# Channel that receives NEW ORDER / WALLET FUNDED / ALMOST GONE posts.
# Add the bot as an admin there. Ids look like -1001234567890.
LOG_CHANNEL_ID=

# ─── FORCE JOIN (optional) ────────────────────────────────────
FORCE_JOIN=0
FORCE_JOIN_CHANNEL_ID=
FORCE_JOIN_LINK=https://t.me/yourchannel
FORCE_JOIN_NAME=your channel

# ─── POSTERS ──────────────────────────────────────────────────
# Master switch. 0 = every screen is text-only and the slots below are
# ignored entirely. Set to 1 to use images.
POSTERS=0
# Each can be an https:// url, a Telegram file_id, or a path to a file in
# the repo. Leave blank to send that screen as plain text.
# A file_id only works for the bot that uploaded it.
BANNER_START=
BANNER_PRODUCTS=
BANNER_WALLET=
BANNER_ORDERS=
BANNER_GIFT=
BANNER_SUPPORT=
BANNER_PROFILE=
POSTER_NEW_ORDER=
POSTER_WALLET_FUNDED=
POSTER_ALMOST_GONE=
POSTER_DELIVERED=

# ─── STORE RULES ──────────────────────────────────────────────
MIN_TOPUP=0.100
MAX_TOPUP=5000
PRICE_DECIMALS=3
ORDER_EXPIRY_MINUTES=30
LOW_STOCK_THRESHOLD=3
DEFAULT_LANG=en
REFERRAL_BONUS=0

# ─── BINANCE PAY ──────────────────────────────────────────────
# merchant.binance.com -> Developers. The Binance Pay button only appears
# once both of these are set.
BINANCE_PAY_KEY=
BINANCE_PAY_SECRET=
BINANCE_PAY_CURRENCY=USDT
BINANCE_PAY_BASE=https://bpay.binanceapi.com
# Optional: shown to customers who prefer paying your Pay ID by hand.
BINANCE_PAY_ID=

# ─── NOWPAYMENTS ──────────────────────────────────────────────
# account.nowpayments.io -> Settings -> Payments -> API keys.
# You must set an outcome (payout) wallet first or the key does nothing.
# No KYC and no domain verification. The bot polls for status, so no public
# URL is needed, and the customer pays to an address shown in the chat.
# Check the key and the per-coin minimum with:
#   python -m tools.check_nowpayments
NOWPAYMENTS_API_KEY=
# Button label shown to customers.
NOWPAYMENTS_LABEL=USDT
# Your prices are quoted in this...
NOWPAYMENTS_CURRENCY=usd
# ...and customers pay in this single coin. usdttrc20 = USDT on Tron (cheap
# network fees). Every coin has its own minimum, so re-run the tool if you
# change it.
NOWPAYMENTS_PAY_CURRENCY=usdttrc20
# Optional, and not required: only set this if you have a public https URL.
NOWPAYMENTS_CALLBACK_URL=

# ─── CRYPTOMUS ────────────────────────────────────────────────
# cryptomus.com -> merchant settings. Use the PAYMENT api key, not the payout
# one. The Crypto button only appears once both of these are set.
# The bot polls for payment status, so no public URL or webhook is needed.
# Check your real fees and per-coin minimums with:
#   python -m tools.check_cryptomus
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=
# Button label shown to customers.
CRYPTOMUS_LABEL=Crypto
# Invoice currency. The customer chooses which coin to pay with.
CRYPTOMUS_CURRENCY=USD
# Optional: force a single coin and/or network instead of letting the customer
# choose. e.g. CRYPTOMUS_TO_CURRENCY=USDT and CRYPTOMUS_NETWORK=tron
CRYPTOMUS_TO_CURRENCY=
CRYPTOMUS_NETWORK=
# Share of Cryptomus' commission charged to the customer, 0-100.
# 100 = the buyer covers the fee and you receive the full invoice amount.
CRYPTOMUS_SUBTRACT=100
# Invoice lifespan in seconds (300-43200). Blank = ORDER_EXPIRY_MINUTES.
# There is no cancel-invoice API, so this is what retires a stale invoice.
CRYPTOMUS_LIFETIME=
# Optional, and not required: only set this if you have a public https URL.
CRYPTOMUS_CALLBACK_URL=

# ─── MANUAL PAYMENTS (optional) ───────────────────────────────
# Adds a "pay by hand" method: the customer presses "I have paid" and an
# admin approves it in the bot.
MANUAL_PAY=0
MANUAL_PAY_LABEL=Pay manually

# ─── CATALOG API (optional) ───────────────────────────────────
# Set a key to expose GET /api/catalog (read-only prices and stock).
STORE_API_KEY=

# ─── BUTTON EXTRAS ────────────────────────────────────────────
# Coloured buttons (green confirm / red cancel / teal primary). Verified
# working on Telegram Desktop 7.1.4; older clients ignore the field and show
# the default colour. Set to 0 only if you want everything plain.
BUTTON_STYLES=1
# Premium emoji *inside* the button chrome. Unverified — off by default; the
# button's emoji comes from its label text instead, which works everywhere.
BUTTON_ICONS=0

# ─── RUNTIME ──────────────────────────────────────────────────
PORT=10000
# Which interface the built-in HTTP server binds to.
#   0.0.0.0   = reachable from the network (what cloud hosts need)
#   127.0.0.1 = this machine only (use this when running at home)
HTTP_HOST=0.0.0.0
POLL_TIMEOUT=30
LOG_LEVEL=INFO
# Where the JSON data files live. Point this at a mounted disk in production.
DATA_DIR=
