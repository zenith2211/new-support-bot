__pycache__/
*.pyc
*.pyo
.env
# Backups of .env hold live credentials just as the original does.
.env.*
!.env.example
.venv/
venv/

# Runtime state — users, orders, catalog, codes. Never commit it.
# Listed as data/* rather than data/ so the negation below can apply: git does
# not descend into an excluded directory.
data/*
*.json.tmp

# ...except the emoji map, which is configuration, not state: 69 slot -> id
# mappings and nothing else. It has to be in the repo, because a host with an
# ephemeral disk would otherwise boot with no premium emoji at all.
!data/emoji.json

# Local run logs
bot-run.log
*.log
