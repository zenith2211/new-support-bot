{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "functions": {
    "api/telegram.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,tools/**,node_modules/**,.claude/**,*.md}"
    },
    "api/cron.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,tools/**,node_modules/**,.claude/**,*.md}"
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 3 * * *"
    }
  ]
}
